# Zoho login credentials
ZOHO_EMAIL=you@yourcompany.com
ZOHO_PASSWORD=your-zoho-password

# OPTIONAL but required if your account has Google Authenticator (TOTP) 2FA enabled.
# Paste the secret you saved when scanning the QR code (a base32 string).
# Without this, login from GitHub Actions will fail at the 2FA step.
ZOHO_TOTP_SECRET=

# Zoho data center URLs (must match: same suffix on both)
#   .com  US / global
#   .eu   Europe
#   .in   India
#   .com.au Australia
#   .jp   Japan
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_PEOPLE_URL=https://people.zoho.com

# HTTP read/connect timeout in seconds (default 60). Increase if CI hits read timeouts.
ZOHO_REQUEST_TIMEOUT=60

# Your Zoho People portal slug. From the URL https://people.zoho.com/<portal>/zp
# In your case this is "rebizhr".
ZOHO_PORTAL=rebizhr

# Local timezone used to detect weekends (IANA format).
PUNCH_TIMEZONE=Asia/Karachi

# OPTIONAL geolocation sent with the punch (latitude/longitude/accuracy).
# Example values from your HAR (Hyderabad, Sindh):
#   PUNCH_LATITUDE=25.395759
#   PUNCH_LONGITUDE=68.362558
#   PUNCH_ACCURACY=100
PUNCH_LATITUDE=
PUNCH_LONGITUDE=
PUNCH_ACCURACY=100

# ----- Email notifications (optional) -----
# When SMTP_USER and SMTP_APP_PASSWORD are both set, the script sends an
# HTML+plain email after every punch (success / skip / failure).
#
# Gmail / Google Workspace setup:
#   1. Visit https://myaccount.google.com/apppasswords
#   2. Generate a new App Password (16 characters, no spaces)
#   3. Use the Gmail address as SMTP_USER and the password as SMTP_APP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourcompany.com
SMTP_APP_PASSWORD=

# Optional display name for the From: header.
NOTIFY_FROM=Zoho Punch Bot

# Comma-separated recipient list. Defaults to SMTP_USER if empty.
NOTIFY_TO=

# Which events trigger a notification (comma-separated subset).
# Allowed values: success, skip, failure
NOTIFY_ON=success,skip,failure
